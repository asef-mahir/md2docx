{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Study Guide Watcher",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\watcher.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true,
        "echo": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}